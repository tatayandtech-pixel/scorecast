# Local IDE scratch dir. It currently holds a *copy* of the release signing key
# (AndroidStudio/scorecast-release); the canonical keystore lives outside the repo at the path
# referenced by keystore.properties. This must never be committed.
/AndroidStudio/

# Scratch build logs.
/build_output.log

# JVM crash dumps from an out-of-memory Gradle/Kotlin daemon — regenerable artifacts.
hs_err_pid*.log
replay_pid*.log
/.vscode/

# Release signing: real credentials and keystores never enter the repo (it is public).
/keystore.properties
*.jks
*.keystore
