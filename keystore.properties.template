# Copy this file to `keystore.properties` (same directory) and fill in your own values.
#
#   keystore.properties is gitignored and MUST stay that way — this repo is public.
#   Fill it in by hand in an editor; do not echo the passwords into a shell command,
#   because that puts them in your shell history.
#
# storeFile may be absolute, or relative to the repo root. Keep the .jks itself OUTSIDE
# the repo so an accidental `git add -f` can't reach it.
storeFile=C:/path/to/scorecast-release.jks
storePassword=
keyAlias=
keyPassword=
